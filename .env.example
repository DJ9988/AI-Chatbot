# Kaggle API credentials (used for data/create_dataset.py)
KAGGLE_API_KEY=your_kaggle_token_here

# OpenAI-Compatible LLM API Configuration
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_api_key_here

# Model Selection & Rate-Limit Resilience
PRIMARY_MODEL=meta/llama-3.2-11b-vision-instruct
FALLBACK_MODELS=meta/llama-3.2-90b-vision-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=1

# Observability (MLflow)
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
MLFLOW_EXPERIMENT_NAME=indian_unicorns_chatbot
